---
import "../styles/concept-a.css";
import research from "../data/research.json";

const selectedResearch = research.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Furkan Doğan — economist working on market design, matching theory, and allocation."
    />
    <title>Furkan Doğan — Economist</title>
  </head>

  <body>
    <main class="page">
      <header class="site-header">
        <a class="site-name" href="/a">Furkan Doğan</a>

        <nav class="nav" aria-label="Primary navigation">
          <a href="#research">Research</a>
          <a href="#writing">Writing</a>
          <a href="#">Teaching</a>
          <a href="/furkan-dogan-cv.pdf">CV ↗</a>
        </nav>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">Economist</p>

          <h1>Furkan Doğan</h1>

          <p class="hero-intro">
            I work on market design, matching theory, and constrained allocation.
          </p>

          <p class="hero-note">
            My research studies how preferences, priorities, and institutional
            constraints shape the allocation of scarce resources.
          </p>

          <div class="hero-links">
            <a href="#research">Selected research</a>
            <a href="#writing">Writing</a>
            <a href="/furkan-dogan-cv.pdf">Curriculum vitae ↗</a>
          </div>
        </div>

        <div class="hero-mark" aria-hidden="true">
          <span class="mark-node a"></span>
          <span class="mark-node b"></span>
          <span class="mark-node c"></span>
        </div>
      </section>

      <section class="section" id="research">
        <div class="section-grid">
          <h2 class="section-label">Selected research</h2>

          <div class="research-list">
            {
              selectedResearch.map((paper) => (
                <article class="paper">
                  <div>
                    <h3 class="paper-title">{paper.title}</h3>

                    {paper.authors && (
                      <p class="paper-authors">{paper.authors}</p>
                    )}

                    {paper.summary && (
                      <p class="paper-summary">{paper.summary}</p>
                    )}
                  </div>

                  <p class="paper-meta">
                    {paper.meta}

                    {paper.href && (
                      <a href={paper.href}>Paper ↗</a>
                    )}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="writing">
        <div class="section-grid">
          <h2 class="section-label">Writing</h2>

          <div class="writing-list">
            <div class="writing-row">
              <span class="writing-date">Sep 2026</span>
              <span class="writing-title">
                Allocation is a design problem
              </span>
              <span class="writing-type">Essay</span>
            </div>

            <div class="writing-row">
              <span class="writing-date">Aug 2026</span>
              <span class="writing-title">
                Notes on ranks, priorities, and fairness
              </span>
              <span class="writing-type">Research note</span>
            </div>

            <div class="writing-row">
              <span class="writing-date">Jul 2026</span>
              <span class="writing-title">
                When local choices affect global feasibility
              </span>
              <span class="writing-type">Note</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-grid">
          <h2 class="section-label">Research in practice</h2>

          <div class="practice-copy">
            <p>
              Some of my work connects theoretical allocation problems with the
              design of real systems, particularly in higher education and
              geographically constrained scheduling.
            </p>

            <a href="#">Selected applied work →</a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span>© 2026 Furkan Doğan</span>

        <div class="footer-links">
          <a href="mailto:furkandoann@gmail.com">Email</a>
          <a href="/furkan-dogan-cv.pdf">CV</a>
        </div>
      </footer>
    </main>
  </body>
</html>