---
import AllocationDiagram from "../components/AllocationDiagram.astro";
import "../styles/global.css";
import research from "../data/research.json";
type Note = { order: number; type: string; title: string; description: string; placeholder: boolean };
const noteFiles = import.meta.glob<{ frontmatter: Note }>("../content/writing/*.md", { eager: true });
const notes = Object.values(noteFiles).map((file) => file.frontmatter).sort((a, b) => a.order - b.order).slice(0, 3);
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
const canonical = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined;

const year = new Date().getFullYear();
const description =
  "Furkan Doğan — research on market design, matching theory, mechanism design, and fair allocation.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f2ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Furkan Doğan — Economics & Market Design" />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Furkan Doğan — Economics & Market Design" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="noindex, nofollow" />
    <title>Furkan Doğan — Economics & Market Design</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-shell">
      <header class="site-header" aria-label="Primary navigation">
        <a class="wordmark" href="#top" aria-label="Furkan Doğan, home">
          <span>Furkan Doğan</span>
          <span aria-hidden="true">FD / 01</span>
        </a>
        <nav>
          <a href="#research">Research</a>
          <a href="#writing">Writing</a>
          <a href="#practice">In practice</a>
          <a href={asset("furkan-dogan-cv.pdf")} target="_blank" rel="noreferrer">CV <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" id="top" aria-labelledby="hero-title">
          <div class="hero__identity">
            <p class="eyebrow">Economics · Market design</p>
            <h1 id="hero-title"><span>Furkan</span> <span>Doğan</span></h1>
            <div class="hero__position">
              <p>Research on the design of allocation</p>
              <p>Market design · Matching theory · Mechanism design</p>
            </div>
          </div>

          <div class="hero__thesis">
            <p class="hero__question">
              I study allocation and matching problems in which <em>fairness</em>, priorities, and feasibility interact.
            </p>
            <div class="hero__links" aria-label="Key links">
              <a href="#research">Selected research <span aria-hidden="true">↓</span></a>
              <a href="mailto:furkandoann@gmail.com">Email <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="hero__diagram">
            <AllocationDiagram />
          </div>
        </section>

        <section class="section research" id="research" aria-labelledby="research-title">
          <header class="section__header">
            <p class="section__index">I</p>
            <h2 id="research-title">Selected research</h2>
            <p class="section__note">Fairness, priorities, and the structure of feasible allocation.</p>
          </header>

          <ol class="research-list">
            {research.map((paper) => (
              <li class="research-item">
                <span class="research-item__index" aria-hidden="true">{paper.index}</span>
                <p class="research-item__meta">{paper.meta}</p>
                <div class="research-item__body">
                  <h3>{paper.href ? <a href={asset(paper.href)} target="_blank" rel="noreferrer">{paper.title}</a> : paper.title}</h3>
                  <p class="research-item__authors">{paper.authors}</p>
                  <p class="research-item__summary">{paper.summary}</p>
                </div>
                {paper.href && <a class="research-item__link" href={asset(paper.href)} target="_blank" rel="noreferrer" aria-label={`Open PDF: ${paper.title}`}>
                  PDF <span aria-hidden="true">↗</span>
                </a>}
              </li>
            ))}
          </ol>
        </section>

        <section class="section writing" id="writing" aria-labelledby="writing-title">
          <header class="section__header">
            <p class="section__index">II</p>
            <h2 id="writing-title">Recent writing</h2>
            <p class="section__note">Illustrative entries for a future research notebook.</p>
          </header>

          <div class="notes-list">
            {notes.map((note, index) => (
              <article class="note-item">
                <p class="note-item__meta"><span>{String(index + 1).padStart(2, "0")}</span>{note.type}{note.placeholder && " · sample"}</p>
                <h3>{note.title}</h3>
                <p>{note.description}</p>
              </article>
            ))}
          </div>
          <p class="writing__disclaimer">Prototype content: these suggested titles are placeholders, not authored or published essays.</p>
        </section>

        <section class="section practice" id="practice" aria-labelledby="practice-title">
          <header class="section__header section__header--practice">
            <p class="section__index">III</p>
            <h2 id="practice-title">Research in practice</h2>
            <p class="section__note">From a feasibility theorem to a duty-shift allocation system.</p>
          </header>

          <div class="practice__grid">
            <div class="practice__story">
              <p class="practice__kicker">Pharmacy duty-shift allocation · Türkiye</p>
              <h3>Preserve the possibility of completing the market—after every choice.</h3>
              <p>
                A flow-based priority mechanism for many-to-many allocation with local spatial constraints, developed and evaluated with administrative pharmacy scheduling records from Keçiören, Ankara.
              </p>
              <a href={asset("research/spatial-constraints.pdf")} target="_blank" rel="noreferrer">Read the research <span aria-hidden="true">↗</span></a>
            </div>

            <dl class="practice__ledger" aria-label="Project evidence">
              <div><dt>3,905</dt><dd>historical shift records</dd></div>
              <div><dt>213</dt><dd>distinct pharmacies in the source panel</dd></div>
              <div><dt>40</dt><dd>counterfactual robustness scenarios</dd></div>
              <div><dt>2015–25</dt><dd>administrative data horizon</dd></div>
            </dl>
          </div>
          <p class="practice__method-note">
            The counterfactual sample comprises 198 pharmacies. Welfare comparisons use generated preference profiles; they are model-implied, not observed welfare effects.
          </p>
        </section>
      </main>

      <footer class="site-footer">
        <div>
          <p class="site-footer__name">Furkan Doğan</p>
          <p>Market design, matching, and fair allocation.</p>
        </div>
        <div class="site-footer__links">
          <a href="mailto:furkandoann@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/furkandoann" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={asset("furkan-dogan-cv.pdf")} target="_blank" rel="noreferrer">CV</a>
        </div>
        <p class="site-footer__folio">{year} · Homepage study 01<br />Research / writing / allocation</p>
      </footer>
    </div>
  </body>
</html>
