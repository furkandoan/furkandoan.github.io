---
import SiteLayout from "../layouts/SiteLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import Conferences from "../components/Conferences.astro";
import ProjectTimeline from "../components/ProjectTimeline.astro";
import academic from "../data/academic.json";
import research from "../data/research.json";
import { localUrl } from "../lib/urls";
const selectedResearch = research.filter(paper => paper.featured).slice(0, 3);
const alias = Astro.url.pathname.replace(/\/$/, "").endsWith("/final");
---
<SiteLayout noindex={alias}>
  <section class="hero" id="about" aria-labelledby="identity">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Microeconomic theory · Market design</p>
        <h1 id="identity">Furkan Doğan</h1>
        <p class="hero-bio">I am an economist working on matching and mechanism design.
          I study how to allocate discrete resources when preferences, priorities,
          and fairness requirements meet feasibility constraints.</p>
        <p class="hero-affiliation">{academic.position}<br /><span>{academic.institution}</span></p>
        <div class="hero-links">
          <a href={localUrl("research/")}>Explore research <span aria-hidden="true">→</span></a>
          <a href={localUrl("furkan-dogan-cv.pdf")}>Curriculum vitae <span aria-hidden="true">↗</span></a>
        </div>
      </div>
<figure class="hero-portrait">
  <img
    src={localUrl("images/furkan-dogan-portrait.jpg")}
    alt="Furkan Doğan"
    width="900"
    height="1200"
    loading="eager"
    decoding="async"
  />
</figure>
    </div>
  </section>

  <section class="section research-section" id="research" aria-labelledby="research-heading">
    <div class="section-head section-head-clean">
      <h2 class="section-kicker" id="research-heading">Selected research</h2>
      <div class="section-head-right">
        <a class="text-link" href={localUrl("research/")}>All research <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="research-layout">
      <div class="research-list">
        {selectedResearch.map((paper, i) => (
          <article class="paper" data-paper={paper.id}>
            <div class="paper-main">
              <p class="entry-label"><span class="paper-number">P{i + 1}</span>{paper.jobMarketPaper ? "Job market paper" : paper.status}</p>
              <h3 class="paper-title"><a href={localUrl(`research/#${paper.id}`)}>{paper.title}</a></h3>
              {paper.authors && <p class="paper-authors">{paper.authors}</p>}
              {paper.journal && <p class="publication-venue">{paper.journal}</p>}
              <details class="paper-details">
                <summary>Summary<span class="sr-only">: {paper.title}</span></summary>
                <p>{paper.summary}</p>
              </details>
            </div>
            <div class="paper-meta">
              {paper.jobMarketPaper && <span>{paper.status}</span>}
              {paper.href && <a href={localUrl(paper.href)} aria-label={`Read PDF: ${paper.title}`}>Paper <span aria-hidden="true">↗</span><span class="file-kind">PDF</span></a>}
            </div>
          </article>
        ))}
      </div>
      <ResearchMap />
    </div>
  </section>

  <section class="section education-section" id="education" aria-labelledby="education-heading">
    <div class="section-head section-head-clean">
      <h2 class="section-kicker" id="education-heading">Education</h2>
      <div class="section-head-right">
        <a class="text-link" href={localUrl("teaching/")}>Teaching experience <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="education-layout">
      <div class="education-list">
        {academic.education.map(entry => (
          <article class="education-entry" data-education={entry.id} tabindex="0">
            <div class="education-main"><h3>{entry.institution}</h3><p class="education-degree">{entry.degree}</p></div>
            <div class="education-meta"><span>{entry.dates}</span><span>Istanbul</span></div>
          </article>
        ))}
      </div>
      <aside class="education-visual" id="educationVisual" data-state="koc" aria-hidden="true">
        <div class="education-logo-stage">
          {academic.education.map(entry => <img class={`education-logo education-logo-${entry.id}`} data-logo={entry.id} src={localUrl(`images/education/${entry.id}.png`)} alt="" loading="lazy" decoding="async" />)}
        </div>
      </aside>
    </div>
  </section>

  <Conferences />

  <section class="section projects-section" id="projects" aria-labelledby="projects-heading">
    <div class="section-head section-head-clean">
      <h2 class="section-kicker" id="projects-heading">Research projects</h2>
    </div>
    <div class="projects-layout">
    <div class="project-list">
      {academic.projects.map(project => (
        <article class="project" id={project.id} data-project={project.id}>
          <div class="project-meta">
            <p class="funding">{project.programme}</p>
            <p>{project.funding}</p>
            <p class="project-role">{project.role}<br />{project.dates}</p>
          </div>
          <div class="project-main">
            <h3>{project.title}</h3>
            <p class="project-subtitle">{project.subtitle}</p>
            <p class="project-question">{project.question}</p>
            <details class="project-details">
              <summary>Approach & contribution<span class="sr-only">: {project.title}</span></summary>
              <dl><dt>Approach</dt><dd>{project.approach}</dd><dt>My contribution</dt><dd>{project.contribution}</dd></dl>
            </details>
            <a class="text-link related-paper" href={localUrl(`research/#${project.paperId}`)}>Related research <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <ProjectTimeline />
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
    <div class="section-head">
      <h2 class="section-kicker" id="contact-heading">Contact</h2>
      <div class="contact-copy">
        <a class="email-link" href={`mailto:${academic.email}`}>{academic.email}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Keep keyboard context even when the pointer leaves an entry.
  function connectVisual(rows: string, visual: string, key: string, fallback: string) {
    const target = document.querySelector<HTMLElement>(visual);
    let hovered: HTMLElement | null = null;
    let focused: HTMLElement | null = null;
    const update = () => { if (target) target.dataset.state = (hovered || focused)?.dataset[key] || fallback; };
    document.querySelectorAll<HTMLElement>(rows).forEach(row => {
      row.addEventListener("pointerenter", event => { if (event.pointerType !== "touch") { hovered = row; update(); } });
      row.addEventListener("pointerleave", () => { hovered = null; update(); });
      row.addEventListener("focusin", () => { hovered = null; focused = row; update(); });
      row.addEventListener("focusout", event => { if (!row.contains(event.relatedTarget as Node)) { focused = null; update(); } });
    });
  }
  connectVisual("[data-paper]", "#researchMap", "paper", "default");
  connectVisual("[data-education]", "#educationVisual", "education", "koc");
</script>
