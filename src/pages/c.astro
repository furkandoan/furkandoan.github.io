---
import "../styles/concept-c.css";
import research from "../data/research.json";

const selectedResearch = research.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Furkan Doğan — economist working on market design, matching theory, and allocation."
    />

    <title>Furkan Doğan — Economist</title>
  </head>

  <body>
    <div class="site">
      <header class="topbar">
        <a class="wordmark" href="/c">Furkan Doğan</a>

        <nav class="nav" aria-label="Primary navigation">
          <a href="#research">Research</a>
          <a href="#writing">Writing</a>
          <a href="#">About</a>
          <a href="/furkan-dogan-cv.pdf">CV ↗</a>
        </nav>
      </header>

      <div class="layout">
        <aside class="identity">
          <div class="identity-main">
            <p class="role">Economist</p>

            <h1>Furkan Doğan</h1>

            <p class="identity-summary">
              Market design, matching theory, and the design of constrained
              allocation systems.
            </p>

            <p class="identity-detail">
              I study how institutions allocate scarce resources when
              preferences, priorities, and feasibility constraints interact.
            </p>

            <div class="identity-links">
              <a href="#research">Research</a>
              <a href="#writing">Writing</a>
              <a href="/furkan-dogan-cv.pdf">CV ↗</a>
              <a href="mailto:furkandoann@gmail.com">Email</a>
            </div>

            <div class="thread" aria-hidden="true">
              <span class="thread-line one"></span>
              <span class="thread-line two"></span>

              <span class="thread-node a"></span>
              <span class="thread-node b"></span>
              <span class="thread-node c"></span>
              <span class="thread-node d"></span>
            </div>
          </div>

          <div class="identity-footer">
            Research · Writing · Teaching<br />
            Allocation and institutional design
          </div>
        </aside>

        <main class="content">
          <section class="intro">
            <p class="intro-label">Research & ideas</p>

            <p class="intro-text">
              My work asks how allocation rules shape who receives what,
              especially when fairness, priorities, and operational constraints
              cannot be separated.
            </p>

            <p class="intro-note">
              Alongside formal research, this site is intended to grow into a
              place for essays, technical notes, and writing on institutions,
              allocation, and related ideas.
            </p>
          </section>

          <section class="section" id="research">
            <div class="section-header">
              <h2 class="section-title">Selected research</h2>
              <a class="section-link" href="#">All research →</a>
            </div>

            <div class="research-list">
              {
                selectedResearch.map((paper) => (
                  <article class="paper">
                    <div>
                      <h3 class="paper-title">{paper.title}</h3>

                      {paper.authors && (
                        <p class="paper-authors">{paper.authors}</p>
                      )}

                      {paper.summary && (
                        <p class="paper-summary">{paper.summary}</p>
                      )}
                    </div>

                    <div class="paper-meta">
                      <div>{paper.meta}</div>

                      {paper.href && (
                        <a href={paper.href}>Paper ↗</a>
                      )}
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="section" id="writing">
            <div class="section-header">
              <h2 class="section-title">Writing</h2>
              <a class="section-link" href="#">All writing →</a>
            </div>

            <p class="writing-intro">
              Essays and working notes that sit beside the formal research:
              sometimes technical, sometimes broader, and not always finished.
            </p>

            <div class="writing-list">
              <div class="note">
                <span class="note-date">Sep 2026</span>

                <span class="note-title">
                  Allocation is a design problem
                </span>

                <span class="note-type">Essay</span>
              </div>

              <div class="note">
                <span class="note-date">Aug 2026</span>

                <span class="note-title">
                  Notes on ranks, priorities, and fairness
                </span>

                <span class="note-type">Research note</span>
              </div>

              <div class="note">
                <span class="note-date">Jul 2026</span>

                <span class="note-title">
                  When local choices affect global feasibility
                </span>

                <span class="note-type">Note</span>
              </div>
            </div>
          </section>

          <section class="section">
            <div class="small-grid">
              <div class="small-block">
                <h3>Research in practice</h3>

                <p>
                  Some of my work connects theoretical allocation questions to
                  operational systems in higher education and geographically
                  constrained scheduling.
                </p>

                <a href="#">Selected applied work →</a>
              </div>

              <div class="small-block">
                <h3>Teaching</h3>

                <p>
                  Courses and notes in economics, mathematics, and topics related
                  to market design and mechanism design.
                </p>

                <a href="#">Teaching →</a>
              </div>
            </div>
          </section>

          <footer class="content-footer">
            <span>© 2026 Furkan Doğan</span>

            <div class="content-footer-links">
              <a href="mailto:furkandoann@gmail.com">Email</a>
              <a href="/furkan-dogan-cv.pdf">CV</a>
            </div>
          </footer>
        </main>
      </div>
    </div>
  </body>
</html>